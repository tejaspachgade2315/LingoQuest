# ==========================================
# 1. Adapter Toggles (The "Switches")
# ==========================================
# Options: "vertex", "groq", "openai"
LLM_PROVIDER=vertex

# Options: "deepgram", "whisper_local"
STT_PROVIDER=deepgram

# Options: "cartesia", "elevenlabs", "gcp_tts"
TTS_PROVIDER=cartesia

# Options: "twilio", "exotel", "browser_only" (for web frontend)
TELEPHONY_PROVIDER=browser_only

# ==========================================
# 2. GCP / Vertex AI Credentials
# ==========================================
GCP_PROJECT_ID=your-gcp-project-id
# Path inside the Docker container mapped to your local secrets folder
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-key.json
GOOGLE_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 3. LiveKit WebRTC Infrastructure
# ==========================================
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ==========================================
# 4. Third-Party AI APIs (Used if Adapters are switched)
# ==========================================
DEEPGRAM_API_KEY=your_deepgram_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_NAME=llama-3.1-8b-instant
CARTESIA_API_KEY=your_cartesia_api_key

# ==========================================
# 5. Telephony (Twilio / Exotel)
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
LIVEKIT_SIP_TRUNK_ID=ST_xxxxxxxxx

EXOTEL_API_KEY=your_exotel_key
EXOTEL_API_TOKEN=your_exotel_token
EXOTEL_SUBDOMAIN=your_exotel_subdomain
EXOTEL_EXOPHONE=your_exophone_number

# ==========================================
# 6. Databases & Queues (Docker Internal Networking)
# ==========================================
REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017/reading_game_db

# ==========================================
# 7. Application Ports & URLs
# ==========================================
PORT=8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
